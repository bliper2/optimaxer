<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="Win" Title="Optimaxer" Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#11111B" Foreground="#CDD6F4"
        FontFamily="Cascadia Mono, Consolas" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- theme brushes: recolored at runtime by Theme.ps1 -->
    <SolidColorBrush x:Key="TileBg" Color="#D0181825"/>
    <SolidColorBrush x:Key="Surface" Color="#99313244"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#CC45475A"/>
    <SolidColorBrush x:Key="Line" Color="#55585B70"/>
    <SolidColorBrush x:Key="Text" Color="#CDD6F4"/>
    <SolidColorBrush x:Key="Muted" Color="#7F849C"/>
    <SolidColorBrush x:Key="Accent" Color="#CBA6F7"/>
    <SolidColorBrush x:Key="Accent2" Color="#89B4FA"/>
    <SolidColorBrush x:Key="Good" Color="#A6E3A1"/>
    <SolidColorBrush x:Key="Warn" Color="#F9E2AF"/>
    <SolidColorBrush x:Key="Bad" Color="#F38BA8"/>
    <SolidColorBrush x:Key="OnAccent" Color="#11111B"/>
    <LinearGradientBrush x:Key="WallGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#11111B" Offset="0"/><GradientStop Color="#1E1E2E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#CBA6F7" Offset="0"/><GradientStop Color="#89B4FA" Offset="1"/>
    </LinearGradientBrush>
    <!-- the "focused window" border: gradient that rotates forever, like hyprland's borderangle -->
    <LinearGradientBrush x:Key="ActiveBorder" StartPoint="0,0" EndPoint="1,1">
      <LinearGradientBrush.RelativeTransform><RotateTransform CenterX="0.5" CenterY="0.5" Angle="45"/></LinearGradientBrush.RelativeTransform>
      <GradientStop Color="#CBA6F7" Offset="0"/><GradientStop Color="#89B4FA" Offset="0.5"/><GradientStop Color="#CBA6F7" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>

    <Style x:Key="Comment" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,14"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- buttons: quiet by default, hover pops slightly -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHi}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- primary: outlined in accent, fills on hover -->
    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
              <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentGrad}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="26"/><Setter Property="Height" Value="22"/><Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHi}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- workspace pills in the bar; the active one stretches -->
    <Style x:Key="Ws" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Width="24" Height="22" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHi}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentGrad}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Width" To="42" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Width" To="24" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="15" Height="15" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource Muted}" Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0">
                <Path x:Name="tick" Data="M 2.5,7.5 L 6,11 L 12,3.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform><ScaleTransform x:Name="ts" ScaleX="0.4" ScaleY="0.4"/></Path.RenderTransform>
                </Path>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentGrad}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/>
                  <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleX" To="0.4" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleY" To="0.4" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                <TextBlock x:Name="ph" Text="/ filter" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Accent2}" Opacity="0.45" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentGrad}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RiskText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Safe"><Setter Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Moderate"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Advanced"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ExtraText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Extra}" Value="Applied"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Extra}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CardItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="0,0,8,0"><ItemsPresenter/></ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="CardTemplate">
      <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="6,8">
        <Border.Background><SolidColorBrush x:Name="rowBg" Color="#00FFFFFF"/></Border.Background>
        <CheckBox Style="{StaticResource CardCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,4,0">
              <TextBlock Style="{StaticResource RiskText}" Text="{Binding RiskText}"/>
              <TextBlock Style="{StaticResource ExtraText}" Text="{Binding ExtraText}"/>
            </StackPanel>
          </Grid>
        </CheckBox>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="rowBg" Storyboard.TargetProperty="Color" To="#14FFFFFF" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="rowBg" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TileBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{DynamicResource WallGrad}">
    <Canvas x:Name="FxCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

    <Grid x:Name="Shell" Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- bar -->
      <Border x:Name="TileBar" Style="{StaticResource Tile}" Padding="8,5">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="optimaxer" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="6,0,14,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="NavDash"     Tag="dash"     Style="{StaticResource Ws}" GroupName="ws" Content="1" IsChecked="True" ToolTip="dashboard"/>
            <RadioButton x:Name="NavTweaks"   Tag="tweaks"   Style="{StaticResource Ws}" GroupName="ws" Content="2" ToolTip="optimize"/>
            <RadioButton x:Name="NavServices" Tag="services" Style="{StaticResource Ws}" GroupName="ws" Content="3" ToolTip="services"/>
            <RadioButton x:Name="NavStartup"  Tag="startup"  Style="{StaticResource Ws}" GroupName="ws" Content="4" ToolTip="startup apps"/>
            <RadioButton x:Name="NavCleanup"  Tag="cleanup"  Style="{StaticResource Ws}" GroupName="ws" Content="5" ToolTip="cleaner"/>
            <RadioButton x:Name="NavDebloat"  Tag="debloat"  Style="{StaticResource Ws}" GroupName="ws" Content="6" ToolTip="debloat apps"/>
            <RadioButton x:Name="NavNetwork"  Tag="network"  Style="{StaticResource Ws}" GroupName="ws" Content="7" ToolTip="network and dns"/>
            <RadioButton x:Name="NavFeatures" Tag="features" Style="{StaticResource Ws}" GroupName="ws" Content="8" ToolTip="windows features"/>
            <RadioButton x:Name="NavTools"    Tag="tools"    Style="{StaticResource Ws}" GroupName="ws" Content="9" ToolTip="repair and tools"/>
            <RadioButton x:Name="NavRice"     Tag="rice"     Style="{StaticResource Ws}" GroupName="ws" Content="0" ToolTip="appearance (themes, background, layout)" Margin="8,0,4,0"/>
          </StackPanel>
          <TextBlock x:Name="BarTitle" Text="~/dashboard" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="BarCpu" Text="cpu --" Foreground="{DynamicResource Accent2}" Margin="0,0,14,0"/>
            <TextBlock x:Name="BarRam" Text="mem --" Foreground="{DynamicResource Accent}" Margin="0,0,14,0"/>
            <TextBlock x:Name="AdminText" Text="user" Foreground="{DynamicResource Warn}" Margin="0,0,14,0"/>
            <TextBlock x:Name="BarClock" Text="--:--" Foreground="{DynamicResource Text}" Margin="0,0,10,0"/>
            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
            <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
            <Button x:Name="BtnClose" Style="{StaticResource WinBtn}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

        <!-- main window -->
        <Border x:Name="TileMain" Style="{StaticResource Tile}" Padding="20,16,12,14">
          <Grid x:Name="PagesHost">

            <!-- 1 dashboard -->
            <Grid x:Name="Page_dash">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="dashboard"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# how tuned is this machine right now"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ScoreText" Text="--" FontSize="54" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,-6,28,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="ScoreHead" Text="scanning..." FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ScoreSub" Style="{StaticResource Comment}" Margin="0,4,0,10" Text="checking which recommended tweaks are active"/>
                  <ProgressBar x:Name="ScoreBar" Maximum="100" Height="8"/>
                </StackPanel>
              </Grid>
              <WrapPanel Grid.Row="2" Margin="0,0,0,18">
                <Button x:Name="BtnOptimize" Style="{StaticResource BtnAccent}" Content="apply recommended" Padding="16,8"/>
                <Button x:Name="BtnFreeRam" Content="free ram"/>
                <Button x:Name="BtnQuickClean" Content="scan junk"/>
                <Button x:Name="BtnRestorePoint" Content="restore point"/>
              </WrapPanel>
              <UniformGrid Grid.Row="3" Columns="2" VerticalAlignment="Top">
                <StackPanel Margin="0,0,14,14"><DockPanel><TextBlock x:Name="CpuText" DockPanel.Dock="Right" Text="--"/><TextBlock Text="cpu" Style="{StaticResource Dim}" VerticalAlignment="Center"/></DockPanel><ProgressBar x:Name="CpuBar" Maximum="100" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Margin="0,0,0,14"><DockPanel><TextBlock x:Name="RamText" DockPanel.Dock="Right" Text="--"/><TextBlock Text="memory" Style="{StaticResource Dim}" VerticalAlignment="Center"/></DockPanel><ProgressBar x:Name="RamBar" Maximum="100" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Margin="0,0,14,0"><DockPanel><TextBlock x:Name="DiskText" DockPanel.Dock="Right" Text="--"/><TextBlock x:Name="DiskLabel" Text="disk" Style="{StaticResource Dim}" VerticalAlignment="Center"/></DockPanel><ProgressBar x:Name="DiskBar" Maximum="100" Margin="0,6,0,0"/></StackPanel>
                <StackPanel><DockPanel><TextBlock x:Name="UpText" DockPanel.Dock="Right" Text="--"/><TextBlock Text="uptime" Style="{StaticResource Dim}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="UpHint" Style="{StaticResource Dim}" Margin="0,6,0,0" Text=" "/></StackPanel>
              </UniformGrid>
            </Grid>

            <!-- 2 optimize -->
            <Grid x:Name="Page_tweaks" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="optimize"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# original values are saved first, every tweak can be undone"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="preset" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="BtnPrRec" Content="recommended"/>
                <Button x:Name="BtnPrGame" Content="gaming"/>
                <Button x:Name="BtnPrPriv" Content="privacy"/>
                <Button x:Name="BtnPrMax" Content="maximum"/>
                <Button x:Name="BtnPrNone" Content="clear"/>
              </WrapPanel>
              <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TwSearch" Style="{StaticResource Search}" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <CheckBox x:Name="ChkRestore" Style="{StaticResource CardCheck}" IsChecked="True" Margin="0,0,12,0"><TextBlock Text="restore point" Style="{StaticResource Dim}"/></CheckBox>
                  <Button x:Name="BtnTwApply" Style="{StaticResource BtnAccent}" Content="apply"/>
                  <Button x:Name="BtnTwUndo" Content="undo"/>
                  <Button x:Name="BtnTwRefresh" Content="rescan" Margin="0"/>
                </StackPanel>
              </Grid>
              <ListBox x:Name="TwList" Grid.Row="3" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
            </Grid>

            <!-- 3 services -->
            <Grid x:Name="Page_services" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="services"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# core system services are hidden. a json backup is written before each change"/>
              </StackPanel>
              <TextBox x:Name="SvSearch" Style="{StaticResource Search}" Grid.Row="1" Margin="0,0,0,8"/>
              <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                <Button x:Name="BtnSvRec" Content="pick recommended"/>
                <Button x:Name="BtnSvManual" Style="{StaticResource BtnAccent}" Content="manual"/>
                <Button x:Name="BtnSvDisable" Style="{StaticResource BtnDanger}" Content="disable"/>
                <Button x:Name="BtnSvAuto" Content="automatic"/>
                <Button x:Name="BtnSvRestore" Content="restore backup"/>
                <Button x:Name="BtnSvRefresh" Content="rescan"/>
              </WrapPanel>
              <ListBox x:Name="SvList" Grid.Row="3" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
            </Grid>

            <!-- 4 startup -->
            <Grid x:Name="Page_startup" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="startup"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# things that launch at sign-in. disabling does not uninstall anything"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="BtnStDisable" Style="{StaticResource BtnAccent}" Content="disable"/>
                <Button x:Name="BtnStEnable" Content="enable"/>
                <Button x:Name="BtnStRefresh" Content="rescan"/>
              </WrapPanel>
              <ListBox x:Name="StList" Grid.Row="2" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
            </Grid>

            <!-- 5 cleaner -->
            <Grid x:Name="Page_cleanup" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="cleaner"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# scan first, then remove only what is ticked. locked files are skipped"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="BtnClScan" Content="scan"/>
                <Button x:Name="BtnClClean" Style="{StaticResource BtnAccent}" Content="clean"/>
                <TextBlock x:Name="ClTotal" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </WrapPanel>
              <ListBox x:Name="ClList" Grid.Row="2" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
            </Grid>

            <!-- 6 debloat -->
            <Grid x:Name="Page_debloat" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="debloat"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# removes preinstalled apps for all users. reinstall from the store if needed"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="BtnDbScan" Content="scan apps"/>
                <Button x:Name="BtnDbRemove" Style="{StaticResource BtnDanger}" Content="remove"/>
              </WrapPanel>
              <ListBox x:Name="DbList" Grid.Row="2" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
            </Grid>

            <!-- 7 network -->
            <Grid x:Name="Page_network" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="network"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# dns applies to every active adapter, doh is registered where windows supports it"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button x:Name="BtnDnsBench" Style="{StaticResource BtnAccent}" Content="benchmark dns"/>
                <Button x:Name="BtnFlushDns" Content="flush cache"/>
                <Button x:Name="BtnDnsShow" Content="show current"/>
                <Button x:Name="BtnResetNet" Style="{StaticResource BtnDanger}" Content="reset stack"/>
              </WrapPanel>
              <TextBlock Grid.Row="2" Text="provider" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="DnsPanel"/></ScrollViewer>
            </Grid>

            <!-- 8 features -->
            <Grid x:Name="Page_features" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="features"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# optional windows components. some need a reboot"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="BtnFtEnable" Style="{StaticResource BtnAccent}" Content="enable"/>
                <Button x:Name="BtnFtDisable" Content="disable"/>
                <Button x:Name="BtnFtRefresh" Content="rescan"/>
              </WrapPanel>
              <ListBox x:Name="FtList" Grid.Row="2" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
            </Grid>

            <!-- 9 tools -->
            <Grid x:Name="Page_tools" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="tools"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# repair and recovery. long jobs run in the background, watch the log"/>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ToolsPanel"/></ScrollViewer>
            </Grid>

            <!-- 0 appearance -->
            <Grid x:Name="Page_rice" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}"><Run Foreground="{DynamicResource Accent}" Text="~/"/><Run Text="rice"/></TextBlock>
                <TextBlock Style="{StaticResource Comment}" Text="# themes, wallpaper effects and window layout. saved automatically"/>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="rice presets" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                  <WrapPanel x:Name="RicePanel" Margin="0,0,0,14"/>
                  <TextBlock Text="theme" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                  <WrapPanel x:Name="ThemePanel" Margin="0,0,0,14"/>
                  <TextBlock Text="wallpaper effect" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                  <WrapPanel x:Name="FxPanel" Margin="0,0,0,14"/>
                  <TextBlock Text="layout" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                  <StackPanel x:Name="LayoutPanel" Margin="0,0,0,14"/>
                  <TextBlock Text="animations" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                  <WrapPanel x:Name="AnimPanel" Margin="0,0,0,14"/>
                  <TextBlock Text="equivalent hyprland.conf" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                  <Border Background="{DynamicResource Surface}" CornerRadius="6" Padding="12,10"><TextBlock x:Name="ConfPreview" FontSize="11.5" Foreground="{DynamicResource Muted}"/></Border>
                  <Button x:Name="BtnConfCopy" Content="copy" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <!-- right column: system info + log -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="TileInfo" Style="{StaticResource Tile}" Padding="16,12">
            <StackPanel>
              <TextBlock x:Name="Logo" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" xml:space="preserve">  ___        _   _
 / _ \ _ __ | |_(_)
| | | | '_ \| __| |
| |_| | |_) | |_| |
 \___/| .__/ \__|_|
      |_|</TextBlock>
              <TextBlock x:Name="SysInfo" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border x:Name="TileLog" Grid.Row="1" Style="{StaticResource Tile}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="14,10,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="BusyText" Text="log" Foreground="{DynamicResource Accent2}"/>
                  <ProgressBar x:Name="BusyBar" Width="70" Height="3" Margin="10,0,0,0" Maximum="100" Visibility="Hidden" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnLogOpen" Content="file" Padding="7,1" FontSize="10.5"/>
                  <Button x:Name="BtnLogCopy" Content="copy" Padding="7,1" FontSize="10.5"/>
                  <Button x:Name="BtnLogClear" Content="clear" Padding="7,1" FontSize="10.5" Margin="0"/>
                </StackPanel>
              </Grid>
              <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="6,2,4,8"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
