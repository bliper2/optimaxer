<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="Win" Title="Optimaxer" Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#FF1B1B1D" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Palette. Theme.ps1 swaps these brushes at runtime; only the key names matter. -->
    <SolidColorBrush x:Key="Bg" Color="#FF1B1B1D"/>
    <SolidColorBrush x:Key="Sidebar" Color="#FF151517"/>
    <SolidColorBrush x:Key="Card" Color="#FF232326"/>
    <SolidColorBrush x:Key="CardHi" Color="#FF2B2B2F"/>
    <SolidColorBrush x:Key="Line" Color="#FF34343A"/>
    <SolidColorBrush x:Key="Selected" Color="#FF1F3331"/>
    <SolidColorBrush x:Key="Text" Color="#FFECECEF"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9B9BA4"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2FA79A"/>
    <SolidColorBrush x:Key="AccentHi" Color="#FF3BBDAE"/>
    <SolidColorBrush x:Key="Good" Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Warn" Color="#FFE0A93B"/>
    <SolidColorBrush x:Key="Bad" Color="#FFE5645F"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FF0B1513"/>

    <!-- Text. No implicit TextBlock style: text inherits Foreground, so controls can recolor their own content. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Comment" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,18"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="ColHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="2,22,0,8"/>
    </Style>
    <Style x:Key="NavGroup" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="22,18,0,6"/>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Icons: 16x16 line drawings, stroke follows the owning control's foreground -->
    <Style x:Key="NavIcon" TargetType="Path">
      <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>
    <Style x:Key="NavLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" CornerRadius="5" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <Border x:Name="wash" Background="#FFFFFFFF" Opacity="0" CornerRadius="5" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <!-- selectable pill used for presets, categories and settings choices -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" CornerRadius="13" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" CornerRadius="7" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHi}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFC42B1C"/><Setter Property="Foreground" Value="#FFFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- sidebar item -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Margin="10,1" Height="36">
              <Border x:Name="bg" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
              </Border>
              <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="barScale" ScaleY="1"/></Border.RenderTransform>
              </Border>
              <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="barScale" Storyboard.TargetProperty="ScaleY" From="0.35" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="barScale" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- inputs -->
    <Style x:Key="CardCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource Muted}" Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="boxScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Path x:Name="tick" Data="M 4,9 L 7.4,12.4 L 13.4,5.2" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderThickness" Value="2.5"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Data="M 6.5,2 A 4.5,4.5 0 1 0 6.5,11 A 4.5,4.5 0 1 0 6.5,2 M 10,10 L 14,14" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="None" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                <TextBlock x:Name="ph" Grid.Column="1" Text="Search" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" Opacity="0.35" CornerRadius="3" Margin="3,0"/></ControlTemplate></Thumb.Template></Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource Line}"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- state labels used inside list rows -->
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="RiskPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="8,1,8,2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Safe"><Setter Property="Visibility" Value="Visible"/><Setter Property="BorderBrush" Value="{DynamicResource Good}"/></DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Moderate"><Setter Property="Visibility" Value="Visible"/><Setter Property="BorderBrush" Value="{DynamicResource Warn}"/></DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Advanced"><Setter Property="Visibility" Value="Visible"/><Setter Property="BorderBrush" Value="{DynamicResource Bad}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RiskPillFlagged" TargetType="Border" BasedOn="{StaticResource RiskPill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Safe"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Extra}" Value="Applied"><Setter Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
        <DataTrigger Binding="{Binding Extra}" Value="Installed"><Setter Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
        <DataTrigger Binding="{Binding Extra}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- lists -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="CardTemplate">
      <Border x:Name="row" Padding="16,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="Transparent">
        <Grid>
          <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" IsHitTestVisible="False" Margin="-16,-11,-16,-11"/>
        <CheckBox Style="{StaticResource CardCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Desc}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Border Style="{StaticResource RiskPill}"><TextBlock Style="{StaticResource PillText}" Text="{Binding Risk}"/></Border>
              <TextBlock Style="{StaticResource StateText}" Text="{Binding Extra}"/>
            </StackPanel>
          </Grid>
        </CheckBox>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TweakTemplate">
      <Border x:Name="row" Padding="16,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="Transparent">
        <Grid>
          <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" IsHitTestVisible="False" Margin="-16,-10,-16,-10"/>
        <CheckBox Style="{StaticResource CardCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Desc}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Border Style="{StaticResource RiskPillFlagged}"><TextBlock Style="{StaticResource PillText}" Text="{Binding Risk}"/></Border>
              <TextBlock Style="{StaticResource StateText}" Text="{Binding Extra}"/>
            </StackPanel>
          </Grid>
        </CheckBox>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AppTile">
      <Border x:Name="tile" Width="218" Height="46" Margin="0,0,8,8" CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0" ToolTip="{Binding Desc}">
        <Grid>
          <Border x:Name="wash" Background="{DynamicResource Text}" Opacity="0" CornerRadius="7" IsHitTestVisible="False" Margin="-12,0"/>
        <CheckBox Style="{StaticResource CardCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource StateText}" Text="{Binding Extra}"/>
            <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0">
              <Border CornerRadius="5" Background="{DynamicResource CardHi}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </CheckBox>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="TileItems" TargetType="ItemsControl">
      <Setter Property="ItemTemplate" Value="{StaticResource AppTile}"/>
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{DynamicResource Bg}">
    <Grid x:Name="Shell">
      <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <Border x:Name="SideTop" Padding="22,0,0,0" Height="56">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ContentControl x:Name="LogoHost" Width="26" Height="26" Margin="0,0,11,0" VerticalAlignment="Center"/>
              <TextBlock Text="Optimaxer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
              <RadioButton x:Name="NavDash" Tag="dash" Style="{StaticResource Nav}" GroupName="ws" IsChecked="True">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2.5,2.5 H 7 V 7 H 2.5 Z M 9,2.5 H 13.5 V 7 H 9 Z M 2.5,9 H 7 V 13.5 H 2.5 Z M 9,9 H 13.5 V 13.5 H 9 Z"/><TextBlock Style="{StaticResource NavLabel}" Text="Dashboard"/></StackPanel>
              </RadioButton>

              <TextBlock Style="{StaticResource NavGroup}" Text="SET UP"/>
              <RadioButton x:Name="NavInstall" Tag="install" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2.5,5 L 8,2 L 13.5,5 L 13.5,11 L 8,14 L 2.5,11 Z M 2.5,5 L 8,8 L 13.5,5 M 8,8 V 14"/><TextBlock Style="{StaticResource NavLabel}" Text="Apps"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavTweaks" Tag="tweaks" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2,4 H 5 M 9,4 H 14 M 2,8 H 8 M 12,8 H 14 M 2,12 H 3 M 7,12 H 14 M 5,2.6 V 5.4 M 10,6.6 V 9.4 M 5,10.6 V 13.4"/><TextBlock Style="{StaticResource NavLabel}" Text="Tweaks"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavDebloat" Tag="debloat" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2.5,4.5 H 13.5 M 6,4.5 V 2.5 H 10 V 4.5 M 4,4.5 L 4.8,13.5 H 11.2 L 12,4.5 M 6.8,7 V 11 M 9.2,7 V 11"/><TextBlock Style="{StaticResource NavLabel}" Text="Debloat"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavServices" Tag="services" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2.5,3 H 13.5 V 7 H 2.5 Z M 2.5,9 H 13.5 V 13 H 2.5 Z M 5,5 H 5.01 M 5,11 H 5.01"/><TextBlock Style="{StaticResource NavLabel}" Text="Services"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavStartup" Tag="startup" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 8,2 V 8 M 4.6,4.4 A 5.2,5.2 0 1 0 11.4,4.4"/><TextBlock Style="{StaticResource NavLabel}" Text="Startup"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavFeatures" Tag="features" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2.5,3 H 13.5 V 13 H 2.5 Z M 2.5,6.5 H 13.5 M 5,4.75 H 5.01"/><TextBlock Style="{StaticResource NavLabel}" Text="Features"/></StackPanel>
              </RadioButton>

              <TextBlock Style="{StaticResource NavGroup}" Text="MAINTAIN"/>
              <RadioButton x:Name="NavCleanup" Tag="cleanup" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 8,2 L 9.3,6.7 L 14,8 L 9.3,9.3 L 8,14 L 6.7,9.3 L 2,8 L 6.7,6.7 Z"/><TextBlock Style="{StaticResource NavLabel}" Text="Cleaner"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavNetwork" Tag="network" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 8,2 A 6,6 0 1 0 8,14 A 6,6 0 1 0 8,2 M 2,8 H 14 M 8,2 C 5.4,5 5.4,11 8,14 M 8,2 C 10.6,5 10.6,11 8,14"/><TextBlock Style="{StaticResource NavLabel}" Text="Network"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavTools" Tag="tools" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 10.6,2.4 A 3.2,3.2 0 0 0 6.6,6.8 L 2.6,10.8 A 1.5,1.5 0 0 0 5.2,13.4 L 9.2,9.4 A 3.2,3.2 0 0 0 13.6,5.4 L 11.4,7.6 L 8.8,7.2 L 8.4,4.6 Z"/><TextBlock Style="{StaticResource NavLabel}" Text="Tools"/></StackPanel>
              </RadioButton>

              <TextBlock Style="{StaticResource NavGroup}" Text="MORE"/>
              <RadioButton x:Name="NavConfig" Tag="config" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 4,2 H 9.5 L 12.5,5 V 14 H 4 Z M 9.5,2 V 5 H 12.5 M 6,8.5 H 10.5 M 6,11 H 10.5"/><TextBlock Style="{StaticResource NavLabel}" Text="Config"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavSettings" Tag="settings" Style="{StaticResource Nav}" GroupName="ws">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 13,9.6 A 5.6,5.6 0 1 1 6.4,3 A 4.4,4.4 0 0 0 13,9.6 Z"/><TextBlock Style="{StaticResource NavLabel}" Text="Settings"/></StackPanel>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" Padding="22,12,16,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=AdminText}"/>
                <TextBlock x:Name="AdminText" Text="user" FontSize="12"/>
              </StackPanel>
              <TextBlock x:Name="BarSub" Text="" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- main column -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- title strip: drag area, live numbers, update notice, window buttons -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Background="Transparent">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="BtnUpdate" Style="{StaticResource BtnAccent}" Content="Update available" Height="26" Padding="12,0" Margin="0,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="BarCpu" Text="CPU --" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock x:Name="BarRam" Text="RAM --" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="&#xE921;"/>
            <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="&#xE922;"/>
            <Button x:Name="BtnClose" Style="{StaticResource WinClose}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="PagesHost" Grid.Row="1" Margin="36,4,36,0">

          <!-- dashboard -->
          <Grid x:Name="Page_dash">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard"/>
                <TextBlock Style="{StaticResource Comment}" Text="How well tuned this PC is right now, and the quickest ways to improve it."/>

                <Border Style="{StaticResource Panel}" Padding="24,22">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="ScoreText" Text="--" FontSize="48" FontWeight="SemiBold" Margin="0,-6,28,0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ScoreHead" Text="Scanning" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ScoreSub" Style="{StaticResource Comment}" Margin="0,3,0,12" Text="Checking which recommended tweaks are active."/>
                        <ProgressBar x:Name="ScoreBar" Maximum="100"/>
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,22,0,0">
                      <Button x:Name="BtnOptimize" Style="{StaticResource BtnAccent}" Content="Apply recommended" Padding="18,0" Height="34"/>
                      <Button x:Name="BtnFreeRam" Content="Free RAM" Height="34"/>
                      <Button x:Name="BtnQuickClean" Content="Scan for junk" Height="34"/>
                      <Button x:Name="BtnRestorePoint" Content="Create restore point" Height="34"/>
                    </WrapPanel>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                      <StackPanel>
                        <CheckBox x:Name="ChkAutoClean" Style="{StaticResource CardCheck}" ToolTip="Runs in the background as a scheduled task, even when Optimaxer is closed">
                          <TextBlock Text="Free RAM and clear temp files every hour"/>
                        </CheckBox>
                        <TextBlock x:Name="AutoCleanInfo" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="30,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,16,-12,0">
                  <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,12,12"><StackPanel>
                    <DockPanel><TextBlock x:Name="CpuText" DockPanel.Dock="Right" Text="--"/><TextBlock Text="Processor" Style="{StaticResource Dim}"/></DockPanel>
                    <ProgressBar x:Name="CpuBar" Maximum="100" Margin="0,10,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,12,12"><StackPanel>
                    <DockPanel><TextBlock x:Name="RamText" DockPanel.Dock="Right" Text="--"/><TextBlock Text="Memory" Style="{StaticResource Dim}"/></DockPanel>
                    <ProgressBar x:Name="RamBar" Maximum="100" Margin="0,10,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,12,12"><StackPanel>
                    <DockPanel><TextBlock x:Name="DiskText" DockPanel.Dock="Right" Text="--"/><TextBlock x:Name="DiskLabel" Text="Disk" Style="{StaticResource Dim}"/></DockPanel>
                    <ProgressBar x:Name="DiskBar" Maximum="100" Margin="0,10,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,12,12"><StackPanel>
                    <DockPanel><TextBlock x:Name="UpText" DockPanel.Dock="Right" Text="--"/><TextBlock Text="Uptime" Style="{StaticResource Dim}"/></DockPanel>
                    <TextBlock x:Name="UpHint" Style="{StaticResource Dim}" Margin="0,10,0,0" Text=" "/></StackPanel></Border>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>
            <Border x:Name="TileInfo" Grid.Column="2" Style="{StaticResource Panel}" Padding="20,16" VerticalAlignment="Top" Margin="0,71,0,20">
              <StackPanel>
                <TextBlock Text="This PC" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel x:Name="SysInfoPanel"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- apps -->
          <Grid x:Name="Page_install" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Apps"/>
              <TextBlock Style="{StaticResource Comment}" Text="Install, upgrade or remove apps through WinGet. Every install is verified afterwards."/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnInstall" Style="{StaticResource BtnAccent}" Content="Install / upgrade"/>
                <Button x:Name="BtnUninstall" Style="{StaticResource BtnDanger}" Content="Uninstall"/>
                <Button x:Name="BtnUpgradeAll" Content="Upgrade all"/>
                <Button x:Name="BtnShowInstalled" Content="Show installed"/>
                <Button x:Name="BtnInstClear" Style="{StaticResource BtnSmall}" Content="Clear selection"/>
              </StackPanel>
              <TextBox x:Name="InstSearch" Grid.Column="1" Style="{StaticResource Search}" Margin="12,0,16,0" MinWidth="120"/>
              <TextBlock x:Name="InstCount" Grid.Column="2" Text="Selected: 0" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InstCats" Margin="0,0,10,20"/></ScrollViewer>
          </Grid>

          <!-- tweaks -->
          <Grid x:Name="Page_tweaks" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Tweaks"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="Tick what you want, then run. Each tweak saves the original value first, so it can be undone."/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Presets" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <Button x:Name="BtnPrRec" Style="{StaticResource Chip}" Content="Recommended"/>
                <Button x:Name="BtnPrGame" Style="{StaticResource Chip}" Content="Gaming"/>
                <Button x:Name="BtnPrPriv" Style="{StaticResource Chip}" Content="Privacy"/>
                <Button x:Name="BtnPrDeai" Style="{StaticResource Chip}" Content="Remove AI and debloat"/>
                <Button x:Name="BtnPrMax" Style="{StaticResource Chip}" Content="Maximum"/>
                <Button x:Name="BtnPrNone" Style="{StaticResource Chip}" Content="Clear" BorderBrush="Transparent"/>
              </WrapPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="TwSearch" Style="{StaticResource Search}" MinWidth="120" Margin="0,0,16,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="TwCount" Text="" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkRestore" Style="{StaticResource CardCheck}" IsChecked="True" Margin="0,0,18,0" ToolTip="Create a Windows restore point before applying"><TextBlock Text="Restore point first" Style="{StaticResource Dim}"/></CheckBox>
                <Button x:Name="BtnTwApply" Style="{StaticResource BtnAccent}" Content="Apply selected"/>
                <Button x:Name="BtnTwUndo" Content="Undo selected"/>
                <Button x:Name="BtnTwRefresh" Content="Re-check" Margin="0"/>
              </StackPanel>
            </Grid>
            <WrapPanel x:Name="TwCats" Grid.Row="3" Margin="0,0,0,6"/>
            <ScrollViewer x:Name="TwScroll" Grid.Row="4" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="TwCol1" Margin="0,0,10,24"/>
            </ScrollViewer>
          </Grid>

          <!-- config -->
          <Grid x:Name="Page_config" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitle}" Text="Config"/>
                <TextBlock Style="{StaticResource Comment}" Text="Save what is ticked on Apps and Tweaks, load it on another PC, or run it without opening the window."/>
                <Border Style="{StaticResource Panel}" Padding="20,18">
                  <StackPanel>
                    <TextBlock Text="Selection" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="CfgSummary" Style="{StaticResource Comment}" Margin="0,4,0,14"/>
                    <WrapPanel>
                      <Button x:Name="BtnCfgExport" Style="{StaticResource BtnAccent}" Content="Export selection"/>
                      <Button x:Name="BtnCfgImport" Content="Import selection"/>
                      <Button x:Name="BtnCfgClear" Style="{StaticResource BtnSmall}" Content="Clear all selections"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Shortcut" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="A desktop shortcut that starts Optimaxer with administrator rights."/>
                    <WrapPanel><Button x:Name="BtnShortcut" Content="Create desktop shortcut"/></WrapPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Run unattended" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,12" Text="Apply a preset or an exported selection from a script or scheduled task."/>
                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,12"><TextBlock x:Name="CfgHelp" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
                    <Button x:Name="BtnCfgCopyCmd" Content="Copy example command" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- services -->
          <Grid x:Name="Page_services" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Services"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="Core system services are hidden. A JSON backup is written before every change."/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnSvRec" Content="Select recommended"/>
                <Button x:Name="BtnSvManual" Style="{StaticResource BtnAccent}" Content="Set to Manual"/>
                <Button x:Name="BtnSvDisable" Style="{StaticResource BtnDanger}" Content="Disable"/>
                <Button x:Name="BtnSvAuto" Content="Set to Automatic"/>
                <Button x:Name="BtnSvRestore" Content="Restore backup"/>
                <Button x:Name="BtnSvRefresh" Style="{StaticResource BtnSmall}" Content="Refresh"/>
              </WrapPanel>
              <TextBox x:Name="SvSearch" Grid.Column="1" Style="{StaticResource Search}" Margin="12,0,0,0" MinWidth="180" HorizontalAlignment="Right" Width="260"/>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,20"><ListBox x:Name="SvList" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/></Border>
          </Grid>

          <!-- startup -->
          <Grid x:Name="Page_startup" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Startup"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="Programs that start when you sign in. Disabling one does not uninstall it."/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
              <Button x:Name="BtnStDisable" Style="{StaticResource BtnAccent}" Content="Disable selected"/>
              <Button x:Name="BtnStEnable" Content="Enable selected"/>
              <Button x:Name="BtnStRefresh" Style="{StaticResource BtnSmall}" Content="Refresh"/>
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,20"><ListBox x:Name="StList" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/></Border>
          </Grid>

          <!-- cleaner -->
          <Grid x:Name="Page_cleanup" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Cleaner"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="Scan first, then remove only what is ticked. Files that are in use are skipped."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnClScan" Content="Scan"/>
              <Button x:Name="BtnClClean" Style="{StaticResource BtnAccent}" Content="Clean selected"/>
              <TextBlock x:Name="ClTotal" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,20">
              <Grid>
                <ListBox x:Name="ClList" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
                <TextBlock Text="Press Scan to measure what can be cleaned." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ClList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </Grid>

          <!-- debloat -->
          <Grid x:Name="Page_debloat" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Debloat"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="Remove preinstalled apps for every user. You can reinstall them from the Microsoft Store."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnDbScan" Content="Scan apps"/>
              <Button x:Name="BtnDbRemove" Style="{StaticResource BtnDanger}" Content="Remove selected"/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,20">
              <Grid>
                <ListBox x:Name="DbList" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/>
                <TextBlock Text="Press Scan apps to list the preinstalled apps that can be removed." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DbList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </Grid>

          <!-- network -->
          <Grid x:Name="Page_network" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Network"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="DNS applies to every active adapter. Encrypted DNS is registered where Windows supports it."/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
              <Button x:Name="BtnDnsBench" Style="{StaticResource BtnAccent}" Content="Benchmark DNS"/>
              <Button x:Name="BtnFlushDns" Content="Flush cache"/>
              <Button x:Name="BtnDnsShow" Content="Show current"/>
              <Button x:Name="BtnResetNet" Style="{StaticResource BtnDanger}" Content="Reset network stack"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="DNS provider" Style="{StaticResource ColHead}"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="DnsPanel" Margin="0,0,0,20"/></ScrollViewer>
          </Grid>

          <!-- features -->
          <Grid x:Name="Page_features" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Features"/>
              <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,14" Text="Optional Windows components. Some changes need a restart."/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
              <Button x:Name="BtnFtEnable" Style="{StaticResource BtnAccent}" Content="Enable selected"/>
              <Button x:Name="BtnFtDisable" Content="Disable selected"/>
              <Button x:Name="BtnFtRefresh" Style="{StaticResource BtnSmall}" Content="Refresh"/>
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,20"><ListBox x:Name="FtList" Style="{StaticResource CardList}" ItemTemplate="{StaticResource CardTemplate}"/></Border>
          </Grid>

          <!-- tools -->
          <Grid x:Name="Page_tools" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Tools"/>
              <TextBlock Style="{StaticResource Comment}" Text="Repair and recovery. Long jobs run in the background; progress shows in the log below."/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ToolsPanel" Margin="0,0,0,20"/></ScrollViewer>
          </Grid>

          <!-- settings -->
          <Grid x:Name="Page_settings" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitle}" Text="Settings"/>
                <TextBlock Style="{StaticResource Comment}" Text="Appearance and behavior. Theme and accent changes are saved as you pick them."/>
                <Border Style="{StaticResource Panel}" Padding="20,18">
                  <StackPanel>
                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14"/>
                    <WrapPanel x:Name="ThemePanel" Margin="0,12,0,0"/>
                    <TextBlock Text="Accent colour" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0"/>
                    <WrapPanel x:Name="AccentPanel" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Motion" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,12" Text="Window open, page changes, theme fades and progress bars. Reduce motion keeps the short hover highlights."/>
                    <WrapPanel x:Name="AnimPanel"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Comment}" Margin="0,4,0,12" Text="Look for a newer release on GitHub when Optimaxer starts."/>
                    <WrapPanel x:Name="UpdPanel"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- activity log drawer -->
        <Border x:Name="TileLog" Grid.Row="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Height="38" Margin="36,0,24,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="BusyText" Text="Ready" Style="{StaticResource Dim}"/>
                <ProgressBar x:Name="BusyBar" Width="96" Height="3" Margin="14,0,0,0" Maximum="100" Visibility="Hidden" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnLogOpen" Style="{StaticResource BtnSmall}" Content="Open log file"/>
                <Button x:Name="BtnLogCopy" Style="{StaticResource BtnSmall}" Content="Copy"/>
                <Button x:Name="BtnLogClear" Style="{StaticResource BtnSmall}" Content="Clear"/>
                <Button x:Name="BtnLogToggle" Style="{StaticResource BtnSmall}" Content="Show activity" Margin="6,0,0,0" MinWidth="96"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="Log" Grid.Row="1" Height="170" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="28,0,18,12"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
